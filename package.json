{
  "name": "dungeon-md",
  "version": "1.0.0",
  "private": false,
  "description": "Write Markdown. Play Games. Dungeon.md turns ordinary Markdown into a playable top-down dungeon.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "capture:competition": "node scripts/capture-competition-demo.mjs"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
